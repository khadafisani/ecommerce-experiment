    "../src/AreaChart.svelte",
    "../src/Chart.svelte",
    "../src/CursorMore.svelte",
    "../src/Fields.svelte",
    "../src/ProductGrid.svelte",
    "../src/ProductInitials.svelte",
    "../src/SearchBar.svelte",
    "../src/SearchKindBadge.svelte",
